<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <permission
        android:name="com.weartak.plugin.permission.BIND_PLUGIN"
        android:protectionLevel="signature" />

    <uses-feature
        android:name="android.hardware.type.watch"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.GoTennaWearTak">

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <service
            android:name=".WearTakPluginService"
            android:exported="true"
            android:permission="com.weartak.plugin.permission.BIND_PLUGIN">
            <intent-filter>
                <action android:name="com.weartak.plugin.action.PLUGIN_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
    </application>
</manifest>
